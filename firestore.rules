rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Só contas cadastradas manualmente em /usuarios/{uid} têm acesso.
    // Contas criadas via API REST do Auth (apiKey é pública) não passam aqui.
    function isAuthorized() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuthorized()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.admin == true;
    }

    // Cada usuário só lê o próprio registro; escrita só pelo Console/Admin SDK.
    match /usuarios/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /lancamentos/{docId} {
      allow read, write: if isAuthorized();
    }

    match /despesas/{docId} {
      allow read, write: if isAuthorized();
    }

    match /comissoes/{docId} {
      allow read, write: if isAuthorized();
    }

    match /configuracoes/{docId} {
      allow read, write: if isAuthorized();
    }

    match /financeiro/{docId} {
      allow read, write: if isAuthorized();
    }

    match /movimentacoes/{docId} {
      allow read, write: if isAuthorized();
    }

    match /clientes_vale/{docId} {
      allow read, write: if isAuthorized();
    }

    match /fechamentos/{docId} {
      allow read, write: if isAuthorized();
    }

    // Base de clientes — ID = telefone 55+DDD+número
    match /clientes/{telefone} {
      allow read, write: if isAuthorized();
    }

    // Reservas — ID = {telefone}_{AAAAMMDD}_{HHmm}
    match /agendamentos/{docId} {
      allow read, write: if isAuthorized();
    }

    // Assinantes — ID = telefone. Sem CPF/e-mail: barbeiros leem.
    // Barbeiro só cria/altera origem "balcao"; celcoin/abacatepay só admin (ou a função, que ignora regras).
    match /assinantes/{telefone} {
      allow read: if isAuthorized();
      allow create: if isAdmin()
        || (isAuthorized() && request.resource.data.origem == 'balcao');
      allow update: if isAdmin()
        || (isAuthorized() && resource.data.origem == 'balcao' && request.resource.data.origem == 'balcao');
      allow delete: if isAdmin();
    }

    // Pagamentos da Celcoin — ID = {telefone}_{transacao_id}. Tem CPF/e-mail: só admin.
    match /pagamentos_assinatura/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
