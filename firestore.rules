rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Só contas cadastradas manualmente em /usuarios/{uid} têm acesso.
    // Contas criadas via API REST do Auth (apiKey é pública) não passam aqui.
    function isAuthorized() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuthorized()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.admin == true;
    }

    // Cada usuário só lê o próprio registro; escrita só pelo Console/Admin SDK.
    match /usuarios/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /lancamentos/{docId} {
      allow read, write: if isAuthorized();
    }

    match /despesas/{docId} {
      allow read, write: if isAuthorized();
    }

    match /comissoes/{docId} {
      allow read, write: if isAuthorized();
    }

    match /configuracoes/{docId} {
      allow read, write: if isAuthorized();
    }

    match /financeiro/{docId} {
      allow read, write: if isAuthorized();
    }

    match /movimentacoes/{docId} {
      allow read, write: if isAuthorized();
    }

    // Clientes do vale: sem telefone (fica em clientes_privado; o app grava cliente_id)
    match /clientes_vale/{docId} {
      allow read, delete: if isAuthorized();
      allow create, update: if isAuthorized() && !('telefone' in request.resource.data);
    }

    match /fechamentos/{docId} {
      allow read, write: if isAuthorized();
    }

    // Base de clientes — ID = código do cliente (c_...), sem telefone.
    // Gravada só pelas funções (Booksy, Celcoin, resolverCliente).
    match /clientes/{cid} {
      allow read: if isAuthorized();
      allow write: if isAdmin();
    }

    // Telefone de cada cliente — ID = código do cliente. Só admin.
    match /clientes_privado/{cid} {
      allow read, write: if isAdmin();
    }

    // Reservas — ID = {código}_{AAAAMMDD}_{HHmm}. Gravadas pela função do Booksy.
    match /agendamentos/{docId} {
      allow read: if isAuthorized();
      allow write: if isAdmin();
    }

    // Assinantes — ID = telefone. Cadastro completo: só admin.
    // Venda no balcão pelo barbeiro passa pela função venderAssinaturaBalcao.
    match /assinantes/{telefone} {
      allow read, write: if isAdmin();
    }

    // Visão reduzida para barbeiros (nome, plano, status, vencimento, dependente): sem telefone nem valores.
    // ID = código do cliente. Mantida pela função sincronizarAssinantePublico.
    match /assinantes_publico/{cid} {
      allow read: if isAuthorized();
      allow write: if false;
    }

    // Resumo mensal de assinaturas: gravado só pelas funções (Admin SDK)
    match /resumos_assinatura/{mes} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Pagamentos da Celcoin — ID = {código}_{transacao_id}. Tem telefone, CPF e e-mail: só admin.
    match /pagamentos_assinatura/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
